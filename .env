# ==============================================================\n# CRYPTO FUTURES BOT — VARIÁVEIS DE AMBIENTE V2.8 (PRODUÇÃO OTIMIZADA)\n# Copie e cole no painel Environment do Render ou no seu arquivo .env\n# ==============================================================\n\n# 1. Configurações do Telegram\nBOT_TOKEN=seu_bot_token_aqui\nTELEGRAM_CHAT_ID=\n\n# 2. API de Dados de Mercado (Coinalyze)\nCOINALYZE_API_KEY=sua_coinalyze_api_key_aqui\n\n# 3. Inteligência Artificial (OpenRouter + Gemini Fallback)\nGEMINI_API_KEY=sua_gemini_api_key_aqui\nOPENROUTER_API_KEY=sua_openrouter_api_key_aqui\nAI_ENABLED=true\nAI_MIN_CONFIDENCE=76\n\n# 4. Parâmetros de Alta Assertividade V2.8 (Auto BE +0.36R · Trava Correlação)\nPAPER_TRADING_ENABLED=true\nPAPER_FAST_ENTRY_ENABLED=true\nPAPER_QUICK_SCALP_ENABLED=true\nPAPER_QUICK_SCALP_TARGET_NET_PCT=0.95\nPAPER_QUICK_SCALP_STOP_NET_PCT=0.68\nPAPER_QUICK_SCALP_MAX_MINUTES=90\nPAPER_QUICK_MIN_REWARD_RISK=1.15\nPAPER_QUICK_MAX_BREAK_EVEN_PCT=48\nPAPER_HIGH_ACCURACY_TP1_R=0.55\nPAPER_HIGH_ACCURACY_TP2_R=0.95\nPAPER_HIGH_ACCURACY_TP3_R=1.45\n\n# 5. Gestão de Margem e Alavancagem Saudável\nPAPER_QUICK_SCALP_MARGIN_USDC=15\nPAPER_QUICK_SCALP_LEVERAGE=5\nPAPER_MAX_OPEN_POSITIONS=2\n\n# 6. Penalidades Suavizadas (Evita bloquear Score 86-90 por 4H ou micro-OI)\nPAPER_FAST_4H_SCORE_PENALTY=2\nPAPER_FAST_MILD_OI_SCORE_PENALTY=2\nPAPER_FAST_STRONG_OI_CONTRARY_PCT=0.55\n\n# ==============================================================\n# 7. EXECUTOR OFICIAL BLOFIN (DEMO / SANDBOX & REAL) — CRIPTO + AÇÕES\n# ==============================================================\nBLOFIN_EXECUTION_ENABLED=true\nBLOFIN_DEMO=true\nBLOFIN_API_KEY=\nBLOFIN_SECRET_KEY=\nBLOFIN_PASSPHRASE=\nBLOFIN_MARGIN_USDT=12\nBLOFIN_LEVERAGE=5\nBLOFIN_MARGIN_MODE=cross\nBLOFIN_MAX_OPEN_POSITIONS=4\nBLOFIN_STOCKS_ENABLED=true\nENABLE_EQUITIES_SCANNER=true\n\n# 8. Filtros de Pullback Calibrados (Destrava ARBUSDT, ALGO, JUP, GALA, PENDLE)\nMIN_SCORE=80\nPAPER_MIN_SCORE=80\nPAPER_MIN_AI_CONFIDENCE=76\nPAPER_ACTIVE_PULLBACK_MIN_SCORE=80\nPAPER_ACTIVE_PULLBACK_MIN_AI=76\nPAPER_ACTIVE_PULLBACK_MIN_TRIGGER_QUALITY=3\nPAPER_ACTIVE_PULLBACK_MAX_CHASE_ATR=1.25\nPAPER_ACTIVE_PULLBACK_MIN_CONFIRM_VOLUME=0.55\nPULLBACK_MAX_DISTANCE_ATR_MIN=1.05\nPULLBACK_MAX_DISTANCE_ATR_MAX=1.55\n\n# 9. Filtros de Rompimento Calibrados (Destrava CRVUSDT 100/100, SOL, INJ, BTC, HBAR)\nQUALITY_BREAKOUT_MIN_SCORE=84\nPAPER_BREAKOUT_MIN_SCORE=84\nPAPER_ACTIVE_BREAKOUT_MIN_SCORE=84\nPAPER_ACTIVE_BREAKOUT_MIN_AI=78\nPAPER_ACTIVE_BREAKOUT_MIN_VOLUME=1.00\nPAPER_ACTIVE_BREAKOUT_MIN_EDGE=8\nPAPER_ACTIVE_BREAKOUT_MAX_BODY_ATR=1.55\nPAPER_ACTIVE_BREAKOUT_MAX_DISTANCE_ATR=1.75\n\n# 10. Confirmed Entry Inteligente + Fast Entry 1-Candle (Evita armar no fim do movimento)\nCONFIRMED_ENTRY_MAX_WAIT_BARS=3\nCONFIRMED_ENTRY_MIN_VOLUME_RATIO=0.35\nCONFIRMED_ENTRY_VOLUME_RESUME_MULTIPLIER=0.45\nCONFIRMED_ENTRY_STRONG_OI_CONTRARY_PCT=0.55\n\n# 11. Proteção de Bitcoin (Hard Gate)\nQUALITY_BTC_REGIME_GUARD=true\nDIRECTION_REQUIRE_1H=true\nDIRECTION_MIN_EDGE=8\n\n# 12. Sincronização Google Sheets / Backups Drive (Se configurado)\nGOOGLE_SYNC_ENABLED=true\nGOOGLE_SYNC_WEBHOOK_URL=sua_url_google_exec_aqui\nGOOGLE_SYNC_TOKEN=seu_sync_token_aqui\n