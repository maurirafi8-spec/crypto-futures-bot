# ==============================================================
# CRYPTO & TOKENIZED STOCKS BOT — VARIÁVEIS DE AMBIENTE V2.7
# Copie e cole no painel Environment do Render ou no seu arquivo .env
# ==============================================================

# 1. Configurações do Telegram
BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# 2. Conexão BloFin (Criptomoedas & Ações Tokenizadas)
# Ative BLOFIN_DEMO=true para testar em Sandbox (dinheiro virtual)
# Mude para BLOFIN_DEMO=false quando quiser operar na conta Real
BLOFIN_EXECUTION_ENABLED=true
BLOFIN_DEMO=true
BLOFIN_API_KEY=sua_blofin_api_key_aqui
BLOFIN_SECRET_KEY=sua_blofin_secret_key_aqui
BLOFIN_PASSPHRASE=sua_blofin_passphrase_aqui
BLOFIN_LEVERAGE=5
BLOFIN_MARGIN_USDT=12
BLOFIN_MARGIN_MODE=cross
BLOFIN_MAX_OPEN_POSITIONS=4
BLOFIN_STOCKS_ENABLED=true
BLOFIN_MIN_AI_CONFIDENCE=75
BLOFIN_MIN_SCORE=80
BLOFIN_TIMEOUT_MS=15000

# 3. API de Dados de Mercado (Coinalyze)
COINALYZE_API_KEY=sua_coinalyze_api_key_aqui

# 4. Inteligência Artificial (OpenRouter + Gemini Fallback)
GEMINI_API_KEY=sua_gemini_api_key_aqui
OPENROUTER_API_KEY=sua_openrouter_api_key_aqui
AI_ENABLED=true
AI_MIN_CONFIDENCE=76

# 5. Parâmetros de Alta Assertividade V2.2 (Auto Break-Even +0.38R + Parciais TP1 0.55R / TP2 0.95R / TP3 1.45R)
PAPER_TRADING_ENABLED=true
PAPER_FAST_ENTRY_ENABLED=true
PAPER_QUICK_SCALP_ENABLED=true
PAPER_QUICK_SCALP_TARGET_NET_PCT=0.85
PAPER_QUICK_SCALP_STOP_NET_PCT=0.70
PAPER_QUICK_SCALP_MAX_MINUTES=90
PAPER_QUICK_MIN_REWARD_RISK=1.15
PAPER_QUICK_MAX_BREAK_EVEN_PCT=52
PAPER_HIGH_ACCURACY_TP1_R=0.55
PAPER_HIGH_ACCURACY_TP2_R=0.95
PAPER_HIGH_ACCURACY_TP3_R=1.45

# 6. Gestão de Margem e Alavancagem Saudável
PAPER_QUICK_SCALP_MARGIN_USDC=15
PAPER_QUICK_SCALP_LEVERAGE=5
PAPER_MAX_OPEN_POSITIONS=2

# 7. Penalidades Suavizadas (Evita bloquear Score 86-90 por 4H ou micro-OI)
PAPER_FAST_4H_SCORE_PENALTY=2
PAPER_FAST_MILD_OI_SCORE_PENALTY=2
PAPER_FAST_STRONG_OI_CONTRARY_PCT=0.55

# 8. Filtros de Pullback Calibrados (Destrava ARBUSDT, ALGO, JUP, GALA, PENDLE)
MIN_SCORE=80
PAPER_MIN_SCORE=80
PAPER_MIN_AI_CONFIDENCE=76
PAPER_ACTIVE_PULLBACK_MIN_SCORE=80
PAPER_ACTIVE_PULLBACK_MIN_AI=76
PAPER_ACTIVE_PULLBACK_MIN_TRIGGER_QUALITY=3
PAPER_ACTIVE_PULLBACK_MAX_CHASE_ATR=1.25
PAPER_ACTIVE_PULLBACK_MIN_CONFIRM_VOLUME=0.55
PULLBACK_MAX_DISTANCE_ATR_MIN=1.05
PULLBACK_MAX_DISTANCE_ATR_MAX=1.55

# 9. Filtros de Rompimento Calibrados (Destrava CRVUSDT 100/100, SOL, INJ, BTC, HBAR)
QUALITY_BREAKOUT_MIN_SCORE=84
PAPER_BREAKOUT_MIN_SCORE=84
PAPER_ACTIVE_BREAKOUT_MIN_SCORE=84
PAPER_ACTIVE_BREAKOUT_MIN_AI=78
PAPER_ACTIVE_BREAKOUT_MIN_VOLUME=1.00
PAPER_ACTIVE_BREAKOUT_MIN_EDGE=8
PAPER_ACTIVE_BREAKOUT_MAX_BODY_ATR=1.55
PAPER_ACTIVE_BREAKOUT_MAX_DISTANCE_ATR=1.75

# 10. Confirmed Entry Inteligente + Fast Entry 1-Candle
CONFIRMED_ENTRY_MAX_WAIT_BARS=3
CONFIRMED_ENTRY_MIN_VOLUME_RATIO=0.35
CONFIRMED_ENTRY_VOLUME_RESUME_MULTIPLIER=0.45
CONFIRMED_ENTRY_STRONG_OI_CONTRARY_PCT=0.55

# 11. Proteção de Bitcoin (Hard Gate)
QUALITY_BTC_REGIME_GUARD=true
DIRECTION_REQUIRE_1H=true
DIRECTION_MIN_EDGE=8

# 12. Sincronização Google Sheets / Backups Drive (Se configurado)
GOOGLE_SYNC_ENABLED=true
GOOGLE_SYNC_WEBHOOK_URL=sua_url_google_exec_aqui
GOOGLE_SYNC_TOKEN=seu_sync_token_aqui
