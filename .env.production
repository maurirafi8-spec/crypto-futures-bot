# ==============================================================
# CRYPTO FUTURES BOT — VARIÁVEIS DE AMBIENTE V2.1 (FLUXO ATIVO + ALTA ASSERTIVIDADE)
# Copie e cole no painel Environment do Render ou no seu arquivo .env
# ==============================================================

# 1. Configurações do Telegram
BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# 2. API de Dados de Mercado (Coinalyze)
COINALYZE_API_KEY=sua_coinalyze_api_key_aqui

# 3. Inteligência Artificial (OpenRouter + Gemini Fallback)
GEMINI_API_KEY=sua_gemini_api_key_aqui
OPENROUTER_API_KEY=sua_openrouter_api_key_aqui
AI_ENABLED=true
AI_MIN_CONFIDENCE=76

# 4. Parâmetros de Alta Assertividade (Payoff 1.47:1 + Parciais TP1/TP2)
PAPER_TRADING_ENABLED=true
PAPER_FAST_ENTRY_ENABLED=true
PAPER_QUICK_SCALP_ENABLED=true
PAPER_QUICK_SCALP_TARGET_NET_PCT=1.10
PAPER_QUICK_SCALP_STOP_NET_PCT=0.75
PAPER_QUICK_SCALP_MAX_MINUTES=35
PAPER_QUICK_MIN_REWARD_RISK=1.35
PAPER_QUICK_MAX_BREAK_EVEN_PCT=48

# 5. Gestão de Margem e Alavancagem Saudável
PAPER_QUICK_SCALP_MARGIN_USDC=15
PAPER_QUICK_SCALP_LEVERAGE=5
PAPER_MAX_OPEN_POSITIONS=2

# 6. Penalidades Suavizadas (Evita bloquear Score 86-90 por 4H ou micro-OI)
PAPER_FAST_4H_SCORE_PENALTY=2
PAPER_FAST_MILD_OI_SCORE_PENALTY=2
PAPER_FAST_STRONG_OI_CONTRARY_PCT=0.55

# 7. Filtros de Pullback Calibrados (Destrava ALGO, JUP, GALA, PENDLE)
MIN_SCORE=80
PAPER_MIN_SCORE=80
PAPER_MIN_AI_CONFIDENCE=76
PAPER_ACTIVE_PULLBACK_MIN_SCORE=80
PAPER_ACTIVE_PULLBACK_MIN_AI=76
PAPER_ACTIVE_PULLBACK_MIN_TRIGGER_QUALITY=3
PAPER_ACTIVE_PULLBACK_MAX_CHASE_ATR=0.85
PAPER_ACTIVE_PULLBACK_MIN_CONFIRM_VOLUME=0.60
PULLBACK_MAX_DISTANCE_ATR_MIN=1.05
PULLBACK_MAX_DISTANCE_ATR_MAX=1.45

# 8. Filtros de Rompimento Calibrados (Destrava SOL, INJ, BTC, HBAR)
QUALITY_BREAKOUT_MIN_SCORE=84
PAPER_BREAKOUT_MIN_SCORE=84
PAPER_ACTIVE_BREAKOUT_MIN_SCORE=84
PAPER_ACTIVE_BREAKOUT_MIN_AI=78
PAPER_ACTIVE_BREAKOUT_MIN_VOLUME=1.05
PAPER_ACTIVE_BREAKOUT_MIN_EDGE=8
PAPER_ACTIVE_BREAKOUT_MAX_BODY_ATR=1.35
PAPER_ACTIVE_BREAKOUT_MAX_DISTANCE_ATR=1.65

# 9. Confirmed Entry Inteligente (Evita armar e cancelar por ruído)
CONFIRMED_ENTRY_MAX_WAIT_BARS=2
CONFIRMED_ENTRY_MIN_VOLUME_RATIO=0.55
CONFIRMED_ENTRY_VOLUME_RESUME_MULTIPLIER=0.60
CONFIRMED_ENTRY_STRONG_OI_CONTRARY_PCT=0.55

# 10. Proteção de Bitcoin (Hard Gate)
QUALITY_BTC_REGIME_GUARD=true
DIRECTION_REQUIRE_1H=true
DIRECTION_MIN_EDGE=8

# 11. Sincronização Google Sheets / Backups Drive (Se configurado)
GOOGLE_SYNC_ENABLED=true
GOOGLE_SYNC_WEBHOOK_URL=sua_url_google_exec_aqui
GOOGLE_SYNC_TOKEN=seu_sync_token_aqui
